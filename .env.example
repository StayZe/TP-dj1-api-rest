# Copiez ce fichier en .env puis remplissez les valeurs.
# Le fichier .env contient vos secrets : il ne doit JAMAIS être commité (voir .gitignore).

# Adresses vues depuis votre machine. Utilisez 127.0.0.1 et non localhost : sous Windows,
# localhost fait perdre 2 secondes par appel (essai en IPv6 avant repli en IPv4).
DOCKER_API_URL=http://127.0.0.1:2375
NETBOX_URL=http://127.0.0.1:8080

# Token NetBox, obtenu au TP1. Forme : nbt_<clé>.<token>
NETBOX_TOKEN=

# Secrets de votre API, à partir du TP5. Générez-les, ne les inventez pas :
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN_ADMIN=
API_TOKEN_READER=
WEBHOOK_SECRET=
